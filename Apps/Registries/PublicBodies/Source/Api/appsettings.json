{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console",
              "Args": {
                "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console",
                "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
              }
            }
          ]
        }
      }
    ]
  },
  "RequestLogging": {
    "ExcludedPaths": ["/health"]
  },
  "ForwardProxies": {
    "Enabled": "false",
    "KnownProxies": []
  },
  "AllowOrigins": "*",
  "Swagger": {
    "RoutePrefix": "swagger",
    "Info": {
      "Title": "BC Public Bodies Registry Documentation",
      "Description": "Provides API documentation for the BC Public Bodies Registry.",
      "License": {
        "Name": "Apache 2.0(Maybe)",
        "Url": "https://www.apache.org/licenses/LICENSE-2.0.html"
      }
    }
  },
  "OpenTelemetry": {
    "Enabled": false,
    "Sources": ["Adr.*"],
    "ServiceName": "PublicBodies",
    "TraceConsoleExporterEnabled": false,
    "MetricsConsoleExporterEnabled": false,
    "IgnorePathPrefixes": ["/health"]
  },
  "Chefs": {
    "BaseUrl": "https://submit.digital.gov.bc.ca/app",
    "Forms": [
      {
        "FormId": "f7963f90-60a5-476b-84d9-186ef4c9c9ab",
        "ApiKey": ""
      }
    ]
  },
  "AuthCache": {
    "TokenCacheExpireMinutes": "20"
  }
}
