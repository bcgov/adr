{
  "name": "public-bodies-front-end",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "format": "npx prettier . --write",
    "format:check": "npx prettier . --check",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:unit": "vitest --config=vitest.config.ts --project=unit",
    "test:browser": "vitest --config=vitest.config.ts --project=browser",
    "test:browser-headless": "vitest --config=vitest.config.ts --project=browser --browser.headless",
    "generate:schema": "node --env-file=.env node_modules/.bin/openapi-ts --file openapi-ts.config.ts"
  },
  "dependencies": {
    "@bcgov/bc-sans": "2.1.0",
    "@bcgov/design-system-react-components": "0.6.0",
    "@bcgov/design-tokens": "3.2.0",
    "@tanstack/react-query": "5.90.20",
    "@tanstack/react-table": "^8.21.3",
    "mermaid": "^11.14.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "wouter": "^3.9.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@tanstack/eslint-plugin-query": "5.101.2",
    "@types/node": "26.1.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/browser-playwright": "4.1.9",
    "eslint": "10.6.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "prettier": "3.9.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.1",
    "vite": "8.1.3",
    "vitest-browser-react": "2.2.0"
  }
}
