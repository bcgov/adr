{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "ForwardProxies": {
    "Enabled": "false"
  },
  "OpenTelemetry": {
    "Enabled": true,
    "TraceConsoleExporterEnabled": true
  },
  "DictionarySources": {
    "PublicBodies": {
      "Enabled": true,
      "sourceUrl": "http://localhost:5000/swagger/v1/swagger.json"
    }
  },
  "GlossaryBaseUrl": "http://localhost:5001/v1/glossary"
}
